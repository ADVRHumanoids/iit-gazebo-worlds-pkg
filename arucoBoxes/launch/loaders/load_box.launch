<?xml version="1.0"?>
<launch>
  <group scoped="true">
    <arg name="name" default="box"/>
    <arg name="pub_world_pose" default="false"/>

    <arg name="dim_x" default="0.1"/>
    <arg name="dim_y" default="0.1"/>
    <arg name="dim_z" default="0.1"/>
    <arg name="mass" default="0.1"/>
    <arg name="static" default="false"/>
    <arg name="pose_x" default="0" />
    <arg name="pose_y" default="0" />
    <arg name="pose_z" default="0" />
    <arg name="kp" default="1000000"/>
    <arg name="kd" default="1"/>
    <arg name="markers" default="false"/>
    <arg name="red" default="1"/>
    <arg name="green" default="0"/>
    <arg name="blue" default="0"/>
    <arg name="alfa" default="1"/>
    <arg name="gazebo_color" default="Gazebo/ZincYellow"/>

    <arg name="waitFor" default=""/>
    <arg name="launchPrefix" default=""/>  <!-- <arg name="launchPrefix" value="bash -c 'sleep 4; $0 $@'"/> -->

    
    <let name="xacroBox" value="$(find-pkg-share iit_gazebo_worlds_pkg)/arucoBoxes/urdf/box.urdf.xacro
           box_name:=$(var name)
           mass:=$(var mass) 
           static:=$(var static)
           size_x:=$(var dim_x) 
           size_y:=$(var dim_y) 
           size_z:=$(var dim_z) 
           r:=$(var red) 
           g:=$(var green) 
           b:=$(var blue) 
           a:=$(var alfa) 
           gazebo_color:=$(var gazebo_color)
           pose_x:=0 
           pose_y:=0 
           pose_z:=0
           kp:=$(var kp) 
           kd:=$(var kd) 
           markers:=$(var markers)" />
      
    <node pkg="robot_state_publisher" exec="robot_state_publisher" namespace="$(var name)" name="rsp" output="screen">
      <param name="robot_description" value="$(command 'xacro $(var xacroBox)')"/>
    </node>
    
    <node pkg="ros_gz_sim" exec="create" name="urdf_spawner_$(var name)_nowait" respawn="false" output="screen">
      <param name="name" value="$(var name)"/>
      <param name="x" type="float" value="$(var pose_x)"/>
      <param name="y" type="float" value="$(var pose_y)"/>
      <param name="z" type="float" value="$(var pose_z)"/>
      <param name="string" type="str" value="$(command 'xacro $(var xacroBox)')"/>
    </node>

      <!-- TODO WAIT FOR another object to be spawned first -->
    <!--     wait option to be sure it will be spawned after (so. above) the table     -->
    <!-- <node unless="$(eval waitFor == '')" pkg="ros_gz_sim" exec="create" name="urdf_spawner_$(var name)" respawn="false" output="screen">
      <param name="name" value="$(var name)"/>  
      <param name="x" type="float" value="$(var pose_x)"/>
      <param name="y" type="float" value="$(var pose_y)"/>
      <param name="z" type="float" value="$(var pose_z)"/>
      <param name="string" type="str" value="$(command 'xacro $(var xacroBox)')"/>
    </node> -->
    <!--           launch-prefix="bash -c 'sleep 2; $0 $@' "/>  --> <!-- now waiting for the table with -wait option -->

    
    <group if="$(var pub_world_pose)"> 
      <group if="$(var static)">
            <!-- for static objects, publish a static tf from the model description -->
            <node namespace="$(var name)" name="static_tf_pub" pkg="tf2_ros" exec="static_transform_publisher" output="screen"
            args="$(var pose_x) $(var pose_y) $(var pose_z) 0 0 0 world $(var name)"/>
      </group>
      <group unless="$(var static)">
            <!-- TODO: Implement script -->
            <node  name="$(var name)_pose_gazebo_to_tf"
                  pkg="iit_gazebo_worlds_pkg" exec="pose_gazebo_to_tf" output="screen"
                  args="--reference world --models $(var name) --models_link $(var name)_link --ignore_roslaunch_added_param"/>
      </group>
    </group>
  </group>   
</launch>
