<?xml version="1.0"?>
<launch>
  <group scoped="true">

    <arg name="table_name" default="table"/>
    <arg name="table_urdf_name" default="$(var table_name)"/>
    <arg name="parent" default="world" />
    <arg name="pub_world_pose" default="true"/>
    <arg name="spawn_gazebo" default="false"/>
    <arg name="waitFor" default=""/>
    <arg name="rviz" default="false"/>
    <arg name="launchPrefix" default=""/> <!-- <arg name="launchPrefix" value="bash -c 'sleep 4; $0 $@'"/> -->

    <arg name="t_pose_x" default="0.0" />
    <arg name="t_pose_y" default="0.0" />
    <arg name="t_pose_z" default="0.0" />
    
    <arg name="surface_size_x" default="0.8"/>
    <arg name="surface_size_y" default="1.5"/>
    <arg name="surface_size_z" default="0.03"/>
    <arg name="surface_high" default="0.8"/>
    <arg name="surface_mass" default="30"/>
    <arg name="leg_mass" default="2"/>
    <arg name="surface_gazebo_color" default="Gazebo/Wood"/>
    <arg name="leg_gazebo_color" default="Gazebo/Gray"/>
    <arg name="kp" default="1e13"/>
    <arg name="kd" default="1"/>
    <arg name="markers" default="false"/>
    <arg name="marker_size" default="0.18"/>
    <arg name="marker_id" default="0"/>
    <arg name="marker_pos" default="2"/>
    <arg name="marker_thickness" default="0.001" description="if the marker is printed on a thick surface (like a carboard piece) it will be not in line with the table surface but sliglty above. Use this arg for this measure"/>
    
    <!-- TABLE  -->
    <let name="xacroTable" value="$(find-pkg-share iit_gazebo_worlds_pkg)/table/urdf/$(var table_urdf_name).urdf.xacro 
         surface_size_x:=$(var surface_size_x)
         surface_size_y:=$(var surface_size_y)
         surface_size_z:=$(var surface_size_z)
         surface_high:=$(var surface_high)
		     surface_mass:=$(var surface_mass)
         leg_mass:=$(var leg_mass)
         surface_gazebo_color:=$(var surface_gazebo_color)
         leg_gazebo_color:=$(var leg_gazebo_color)         
         kp:=$(var kp)         
         kd:=$(var kd)
         markers:=$(var markers)
         marker_size:=$(var marker_size)
         marker_id:=$(var marker_id)
         marker_pos:=$(var marker_pos)
         marker_thickness:=$(var marker_thickness)
         "
    />
    <!--          keyboard:=$(var keyboard)
         key_size_x:=$(var key_size_x)
         key_size_y:=$(var key_size_y)
         key_size_z:=$(var key_size_z)
         keyboard_rows:=$(var keyboard_rows)
         keyboard_cols:=$(var keyboard_cols)
         keyboard_parent:=$(var keyboard_parent)
         keyboard_x:=$(var keyboard_x)
         keyboard_y:=$(var keyboard_y)
         keyboard_z:=$(var keyboard_z) -->

    
    <group if="$(var spawn_gazebo)"> 
        <node pkg="ros_gz_sim" exec="create" name="urdf_spawner_$(var table_name)" output="screen" respawn="false">
          <param name="name" value="$(var table_name)"/>
          <param name="x" type="float" value="$(var t_pose_x)"/>
          <param name="y" type="float" value="$(var t_pose_y)"/>
          <param name="z" type="float" value="$(var t_pose_z)"/>
          <param name="string" type="str" value="$(command 'xacro $(var xacroTable)')"/>
        </node>
    </group>

    <group if="$(var pub_world_pose)"> 
      <node if="$(var spawn_gazebo)" name="$(var table_name)_pose_gazebo_to_tf"
        pkg="iit_gazebo_worlds_pkg" exec="pose_gazebo_to_tf" output="screen"
        args="--reference world --models $(var table_name) --models_link surface --ignore_roslaunch_added_param"/>
      <node unless="$(var spawn_gazebo)" name="$(var table_name)_static_tf_pub" 
        pkg="tf2_ros" exec="static_transform_publisher" output="screen"
        args="--x $(var t_pose_x) --y $(var t_pose_y) --z $(var t_pose_z) --yaw 0 --pitch 0 --roll 0 --frame-id $(var parent) --child-frame-id surface"
        />
    </group>

    <node if="$(var rviz)" pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(find-pkg-share iit_gazebo_worlds_pkg)/table/config/table.rviz">
    </node> 

  </group>
</launch>
